{
    "config_name": "master-os-research-prod",
    "env": "prod",
    "port": 4100,
    "protocol": "https",
    "domain": "master-os.vercel.app",
    "cookie_name": "master_os_auth_token",
    "jwt_secret": "master-os-v1-secure-hash-key-2026",
    "jwt_secret_v2": "master-os-v2-secure-hash-key-2026",
    "allow_v1_tokens": true,
    "url_signature_secret": "master-os-signature-verification-key",
    "allow_all_host_values": true,
    "allow_no_host_header": true,
    "no_devwatch": true,
    "enable_public_folders": true,
    "is_storage_limited": false,
    "min_pass_length": 8,
    "static_hosting_domain": "site.master-os.vercel.app",
    "static_hosting_domain_alt": "host.master-os.vercel.app",
    "private_app_hosting_domain": "app.master-os.vercel.app",
    "private_app_hosting_domain_alt": "dev.master-os.vercel.app",
    "captcha": { "enabled": false },
    "default_user_group": "78b1b1dd-c959-44d2-b02c-8735671f9997",
    "default_temp_group": "b7220104-7905-4985-b996-649fdcdb3c8f",
    "storage_capacity": 104857600,
    "strict_email_verification_required": false,
    "gui_assets_root": "./src/gui",
    "puterjs_root": "./src/puter-js/dist",
    "builtin_apps": {
        "dev-center": "./src/dev-center"
    },
    "extensions": [
        "./extensions"
    ],
    "database": {
        "engine": "sqlite",
        "path": "volatile/runtime/puter-database.sqlite"
    },
    "s3": {
        "localConfig": {
            "dataDir": "volatile/runtime/fauxqs-data",
            "s3StorageDir": "volatile/runtime/fauxqs-s3-data"
        }
    }
}
